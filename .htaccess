# ==========================================================================
# Caching.
#
# The host serves css/js with a week-long max-age, which is right — those
# URLs carry a ?v= stamp and change name whenever their contents change.
#
# HTML carries no such stamp: index.html is always index.html. Without an
# explicit rule the browser is free to invent its own expiry, which is how a
# newly deployed section stays invisible to the very people who asked for it
# while every check from a fresh browser shows it live. So HTML and the JSON
# the panel rewrites are always revalidated: cheap (a 304 when unchanged),
# and a deploy is visible the moment it lands.
# ==========================================================================

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Content the owner edits in the panel — same reasoning.
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
