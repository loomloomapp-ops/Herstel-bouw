# Admin panel — keep the directory itself reachable, but never serve the
# generated config or let anyone browse the folder listing.
Options -Indexes

<FilesMatch "^config\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
